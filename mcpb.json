{
  "name": "robotics-mcp",
  "version": "0.2.1",
  "type": "server",
  "runtime": "python",
  "entry_point": "src/robotics_mcp/server.py",
  "dependencies": [
    "fastmcp>=3.4.4,<4"
  ],
  "build": {
    "include": [
      "src/**/*",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/",
      ".git/",
      "__pycache__/",
      "*.pyc",
      ".venv/",
      "dist/",
      "build/",
      "target/",
      "docs/",
      "scripts/"
    ]
  },
  "scripts": {
    "build": "mcpb build",
    "pack": "mcpb pack . dist/robotics-mcp.mcpb",
    "test": "python -m pytest"
  }
}
