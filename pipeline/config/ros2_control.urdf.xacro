<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fleet_robot">

  <!-- ros2_control Hardware Interface Definition -->
  <ros2_control name="FleetRobotHardware" type="system">
    <hardware>
      <!-- Simulation plugin: ign_ros2_control / gz_ros2_control / mock -->
      <!-- For physical robot, swap with: <plugin>ethercat_driver/EthercatHardwareInterface</plugin> -->
      <plugin>mock_components/GenericSystem</plugin>
      <param name="mock_sensor_commands">false</param>
      <param name="state_update_frequency">200</param>
    </hardware>

    <!-- 12 Actuated Degrees of Freedom (e.g. Quadruped 3-DoF per leg) -->
    <xacro:macro name="actuated_joint" params="joint_name min_pos max_pos max_vel max_effort">
      <joint name="${joint_name}">
        <command_interface name="position">
          <param name="min">${min_pos}</param>
          <param name="max">${max_pos}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">-${max_effort}</param>
          <param name="max">${max_effort}</param>
        </command_interface>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <!-- Leg FL -->
    <xacro:actuated_joint joint_name="FL_hip_joint" min_pos="-0.8" max_pos="0.8" max_vel="21.0" max_effort="35.0"/>
    <xacro:actuated_joint joint_name="FL_thigh_joint" min_pos="-1.0" max_pos="3.5" max_vel="21.0" max_effort="35.0"/>
    <xacro:actuated_joint joint_name="FL_calf_joint" min_pos="-2.7" max_pos="-0.8" max_vel="21.0" max_effort="35.0"/>

    <!-- Leg FR -->
    <xacro:actuated_joint joint_name="FR_hip_joint" min_pos="-0.8" max_pos="0.8" max_vel="21.0" max_effort="35.0"/>
    <xacro:actuated_joint joint_name="FR_thigh_joint" min_pos="-1.0" max_pos="3.5" max_vel="21.0" max_effort="35.0"/>
    <xacro:actuated_joint joint_name="FR_calf_joint" min_pos="-2.7" max_pos="-0.8" max_vel="21.0" max_effort="35.0"/>

    <!-- Leg RL -->
    <xacro:actuated_joint joint_name="RL_hip_joint" min_pos="-0.8" max_pos="0.8" max_vel="21.0" max_effort="35.0"/>
    <xacro:actuated_joint joint_name="RL_thigh_joint" min_pos="-1.0" max_pos="3.5" max_vel="21.0" max_effort="35.0"/>
    <xacro:actuated_joint joint_name="RL_calf_joint" min_pos="-2.7" max_pos="-0.8" max_vel="21.0" max_effort="35.0"/>

    <!-- Leg RR -->
    <xacro:actuated_joint joint_name="RR_hip_joint" min_pos="-0.8" max_pos="0.8" max_vel="21.0" max_effort="35.0"/>
    <xacro:actuated_joint joint_name="RR_thigh_joint" min_pos="-1.0" max_pos="3.5" max_vel="21.0" max_effort="35.0"/>
    <xacro:actuated_joint joint_name="RR_calf_joint" min_pos="-2.7" max_pos="-0.8" max_vel="21.0" max_effort="35.0"/>

    <!-- Sensors -->
    <sensor name="imu_sensor">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
  </ros2_control>

</robot>
